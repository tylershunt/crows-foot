{
  "name": "crows-foot",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A local dashboard that groups the GitHub pull requests needing your attention into configurable sections.",
  "keywords": [
    "github",
    "pull-requests",
    "dashboard",
    "code-review",
    "cli"
  ],
  "author": "Tyler Hunt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylershunt/crows-foot.git"
  },
  "bugs": {
    "url": "https://github.com/tylershunt/crows-foot/issues"
  },
  "homepage": "https://github.com/tylershunt/crows-foot#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "test": "npm run test:web && npm run test:app",
    "test:web": "tsx --test $(find src shared -name '*.test.ts' | sort)",
    "test:app": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
